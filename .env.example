# Copy to .env. Never commit real credentials.
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3000
DB_PATH=./data/appointments.db
# Defaults to uploads/ alongside DB_PATH. Keep outside public/.
# UPLOAD_DIR=./data/uploads
# Use production only with HTTPS (Secure cookies).
NODE_ENV=development
# Enable only behind a controlled proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0

# Vercel only: persistent cloud database and private image storage.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-database-token
# BLOB_READ_WRITE_TOKEN=your-private-store-token
